//@version=6
indicator("SLB RSI · timeframe-aware", "SLB RSI", overlay=false, precision=1)

// Companion to swing-leader-base.pine: a normal RSI in its own pane under the chart.
lenInput = input.int(0, "RSI length (0 = auto)", minval=0, maxval=50,
     tooltip="Auto: ≤5m 9, ≤1h 12, ≤1D 14, above 1D 10.")
showHtf = input.bool(true, "Higher-timeframe RSI line",
     tooltip="Next step up: ≤5m→15m, ≤15m→1h, ≤1h→4h, ≤4h→1D, 1D→1W, above→1M. Closed bars only, no repaint.")
lineColor = input.color(#7E57C2, "RSI line")
obColor = input.color(color.rgb(164, 216, 190), "Above 70")
osColor = input.color(color.rgb(237, 177, 186), "Below 30")

sec = timeframe.in_seconds()
autoLen = sec <= 300 ? 9 : sec <= 3600 ? 12 : sec <= 86400 ? 14 : 10
len = lenInput > 0 ? lenInput : autoLen
htf = sec <= 300 ? "15" : sec <= 900 ? "60" : sec <= 3600 ? "240" : sec <= 14400 ? "D" : sec <= 86400 ? "W" : "M"

r = ta.rsi(close, len)
rHtf = request.security(syminfo.tickerid, htf, ta.rsi(close, len)[1], lookahead=barmerge.lookahead_on)

h70 = hline(70, "70", color=color.new(chart.fg_color, 55), linestyle=hline.style_dashed)
hline(50, "50", color=color.new(chart.fg_color, 75), linestyle=hline.style_dotted)
h30 = hline(30, "30", color=color.new(chart.fg_color, 55), linestyle=hline.style_dashed)
fill(h70, h30, color=color.new(lineColor, 92), title="30–70 band")

rPlot = plot(r, "RSI", color=lineColor, linewidth=2)
mid70 = plot(70, display=display.none, editable=false)
mid30 = plot(30, display=display.none, editable=false)
fill(rPlot, mid70, 100, 70, top_color=color.new(obColor, 20), bottom_color=color.new(obColor, 85), title="Overbought fill")
fill(rPlot, mid30, 30, 0, top_color=color.new(osColor, 85), bottom_color=color.new(osColor, 20), title="Oversold fill")
plot(showHtf ? rHtf : na, "RSI higher TF", color=color.new(chart.fg_color, 50), linewidth=1, style=plot.style_stepline)

alertcondition(ta.crossover(r, 70), "RSI enters overbought", "{{ticker}} RSI crossed above 70")
alertcondition(ta.crossunder(r, 30), "RSI enters oversold", "{{ticker}} RSI crossed below 30")
